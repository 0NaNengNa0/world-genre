# Copy to .env and fill in real values. Never commit .env.

API_HOST=0.0.0.0
API_PORT=8000

# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Origins allowed to call the API, comma-separated. Defaults to the Vite dev
# server; set this to your real frontend origin when deploying.
CORS_ORIGINS=http://localhost:5173

# --- Warehouse ---
#
# BigQuery dataset as `project.dataset`. Needed by the load, enrichment and
# publish steps. The API does NOT need it: it serves published JSON and never
# queries the warehouse. Neither value is defaulted, because guessing a
# project means risking a write to the wrong one.
BQ_DATASET=world-genre-natt.world_genre

# --- Storage ---
#
# Where the pipeline reads and writes its raw data. Unset means backend/data,
# which is what local runs and the test suite expect. Point it at a bucket in
# Cloud Run, where the container filesystem is ephemeral and the extractor
# caches would otherwise be discarded on every run - losing the MusicBrainz
# cache alone turns an 8-minute pipeline back into a 33-minute one.
# Requires requirements-cloud.txt.
# DATA_DIR=gs://world_genre_bucket/data

# Where run_publish writes the API payloads, and where the API reads them.
# Unset means backend/data/published. This is the only storage setting the
# API itself needs.
# PUBLISH_DIR=gs://world-genre-serving/published
