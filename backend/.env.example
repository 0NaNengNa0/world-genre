# Copy to .env and fill in real values. Never commit .env.

API_HOST=0.0.0.0
API_PORT=8000

# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# App warehouse (docker-compose's app-postgres service - NOT Airflow's own
# metadata DB). This value is for the API/scripts running natively on the
# host (localhost:5433). Airflow containers use a different host for the
# same database - see DATABASE_URL under x-airflow-common-env in
# docker-compose.yaml.
DATABASE_URL=postgresql://world_genre:world_genre@localhost:5433/world_genre

_PIP_ADDITIONAL_REQUIREMENTS=requests beautifulsoup4 lxml python-dotenv
