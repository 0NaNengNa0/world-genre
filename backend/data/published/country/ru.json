st": "Scorpions", "streams": null, "best_position": null}, {"artist": "The Beatles", "streams": null, "best_position": null}, {"artist": "The Rolling Stones", "streams": null, "best_position": null}]}, "electro": {"genre": "electro", "country_code": "ru", "country_name": "Russian Federation", "summary": "Electro is a type of electronic dance music which emerged with the development of early sampling technology and the introduction of the Roland TR-808 drum machine and is closely associated with Hip Hop's formative years in the early to mid 1980s. It is not to be confused with electro house, which is commonly shortened to just \"electro\" in EDM circles. The electro style is defined by the 808 and 808 drum samples arranged in syncopated rhythm patterns often resembling the Funk breaks used in Hip Hop  beats with simple, funky basslines.", "url": null, "artists": [{"artist": "2hollis", "streams": null, "best_position": null}, {"artist": "Aphex Twin", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Crystal Castles", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Mindless Self Indulgence", "streams": null, "best_position": null}, {"artist": "Pendulum", "streams": null, "best_position": null}, {"artist": "Rihanna", "streams": null, "best_position": null}]}, "electronic": {"genre": "electronic", "country_code": "ru", "country_name": "Russian Federation", "summary": "Electronic music refers to music that emphasizes the use of electronic musical instruments or electronic music technology as a central aspect of the sound of the music. Historically, electronic music was considered to be any music created with the use of electronic musical instruments or electronic processing, but in modern times, that distinction has been lost because almost all recorded music today, and the majority of live music performances, depend on extensive use of electronics.", "url": null, "artists": [{"artist": "2hollis", "streams": null, "best_position": null}, {"artist": "Ace of Base", "streams": null, "best_position": null}, {"artist": "Aphex Twin", "streams": null, "best_position": null}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Crystal Castles", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Depeche Mode", "streams": null, "best_position": null}, {"artist": "Eminem", "streams": null, "best_position": null}]}, "hard rock": {"genre": "hard rock", "country_code": "ru", "country_name": "Russian Federation", "summary": "Hard rock is a loosely defined genre of rock music which has its earliest roots in mid-1960s garage, blues rock and psychedelic rock. It is typified by a heavy use of distorted electric guitars, bass guitar, drums, pianos, and keyboards.\n\nOne of the major influences of hard rock is blues music. American and British rock bands began to modify rock and roll, adding to the standard genre harder sounds, heavier guitar riffs, bombastic drumming and louder vocals.", "url": null, "artists": [{"artist": "Black Sabbath", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Disturbed", "streams": null, "best_position": null}, {"artist": "Led Zeppelin", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "My Chemical Romance", "streams": null, "best_position": null}, {"artist": "Queen", "streams": null, "best_position": null}, {"artist": "Scorpions", "streams": null, "best_position": null}, {"artist": "System of a Down", "streams": null, "best_position": null}, {"artist": "Three Days Grace", "streams": null, "best_position": null}]}, "heavy metal": {"genre": "heavy metal", "country_code": "ru", "country_name": "Russian Federation", "summary": "Heavy metal (often referred to simply as metal) is a genre of rock music that developed in the late 1960s and early 1970s, largely in the United Kingdom and the United States. Today, the original genre is often referred to as classic metal or traditional heavy metal.\n\nWith roots in blues-rock and psychedelic rock, the bands that created heavy metal developed a thick, massive sound, characterized by highly amplified distortion, extended guitar solos, emphatic beats, and overall loudness.", "url": null, "artists": [{"artist": "Black Sabbath", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Disturbed", "streams": null, "best_position": null}, {"artist": "Korn", "streams": null, "best_position": null}, {"artist": "Led Zeppelin", "streams": null, "best_position": null}, {"artist": "Marilyn Manson", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "Scorpions", "streams": null, "best_position": null}, {"artist": "Slipknot", "streams": null, "best_position": null}, {"artist": "System of a Down", "streams": null, "best_position": null}, {"artist": "Tool", "streams": null, "best_position": null}]}, "hip-hop": {"genre": "hip-hop", "country_code": "ru", "country_name": "Russian Federation", "summary": "Hip-Hop, also spelled Hip Hop or HipHop is a rhythm focused popular music style, originating from New York in The 70s. The term rap is sometimes used synonymously with Hip-Hop music. Hip-hop arose when DJs began isolating the percussion break from funk or disco songs for audiences to dance to.\nIt is now seen as a worldwide and popular genre ranging from American Mainstream (e.g. Eminem, Lil Wayne) to British Underground (e.g. Wiley, EMC Junkie ect).", "url": null, "artists": [{"artist": "GONE.Fludd", "streams": 28365, "best_position": 31}, {"artist": "\u041f\u043b\u0430\u0442\u0438\u043d\u0430", "streams": 18335, "best_position": 98}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Eminem", "streams": null, "best_position": null}, {"artist": "Gorillaz", "streams": null, "best_position": null}, {"artist": "Kai Angel", "streams": null, "best_position": null}, {"artist": "Kendrick Lamar", "streams": null, "best_position": null}, {"artist": "Limp Bizkit", "streams": null, "best_position": null}, {"artist": "Michael Jackson", "streams": null, "best_position": null}, {"artist": "Miley Cyrus", "streams": null, "best_position": null}, {"artist": "Noize MC", "streams": null, "best_position": null}, {"artist": "Oxxxymiron", "streams": null, "best_position": null}]}, "industrial": {"genre": "industrial", "country_code": "ru", "country_name": "Russian Federation", "summary": "Industrial music is a style of experimental music that draws on transgressive and provocative themes. The term was coined in the mid-1970s with the founding of Industrial Records by the band Throbbing Gristle, and the creation of the slogan \"industrial music for industrial people\". In general, the style is harsh and challenging. Allmusic defines industrial as the \"most abrasive and aggressive fusion of rock and electronic music\"; \"initially a blend of avant-garde electronics experiments tape music.", "url": null, "artists": [{"artist": "Depeche Mode", "streams": null, "best_position": null}, {"artist": "Disturbed", "streams": null, "best_position": null}, {"artist": "Marilyn Manson", "streams": null, "best_position": null}, {"artist": "Mindless Self Indulgence", "streams": null, "best_position": null}, {"artist": "Rammstein", "streams": null, "best_position": null}, {"artist": "The Prodigy", "streams": null, "best_position": null}]}, "metal": {"genre": "metal", "country_code": "ru", "country_name": "Russian Federation", "summary": "A metal is a material that exhibits a lustrous appearance when polished or fractured and conducts electricity and heat relatively efficiently. These properties are associated with the presence of electrons at the Fermi level. Metals are typically ductile, allowing them to be drawn into wires, and malleable, enabling them to be shaped by hammering or pressing.\n\nA metal may be a chemical element, such as iron, an alloy such as stainless steel, or a molecular compound such as polymeric sulfur nitride.", "url": null, "artists": [{"artist": "Black Sabbath", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Disturbed", "streams": null, "best_position": null}, {"artist": "Korn", "streams": null, "best_position": null}, {"artist": "Limp Bizkit", "streams": null, "best_position": null}, {"artist": "Linkin Park", "streams": null, "best_position": null}, {"artist": "Marilyn Manson", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "Rammstein", "streams": null, "best_position": null}, {"artist": "Red Hot Chili Peppers", "streams": null, "best_position": null}]}, "nu metal": {"genre": "nu metal", "country_code": "ru", "country_name": "Russian Federation", "summary": "Nu metal is a subgenre of alternative metal that blends elements of heavy metal with influences from other genres such as hip hop, funk, industrial, and grunge. It typically emphasises rhythm and syncopation, with guitar work often involving down-tuned seven-str