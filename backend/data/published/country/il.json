: null}, {"artist": "Fleetwood Mac", "streams": null, "best_position": null}, {"artist": "Led Zeppelin", "streams": null, "best_position": null}, {"artist": "Pink Floyd", "streams": null, "best_position": null}, {"artist": "Queen", "streams": null, "best_position": null}, {"artist": "The Beatles", "streams": null, "best_position": null}, {"artist": "The Police", "streams": null, "best_position": null}, {"artist": "The Rolling Stones", "streams": null, "best_position": null}]}, "dance-pop": {"genre": "dance-pop", "country_code": "il", "country_name": "Israel", "summary": "Dance-pop is a style of electronic dance music and a subgenre of pop music that evolved from Disco, circa 1981, that combines dance beats with a pop/R'n'B song structure. Because there is such an emphasis on fully-formed songs in dance-pop, it's often viewed as a separate classification unto itself apart from pure dance. Dance-pop is also closely related to the teen pop and Eurodance movements in the mid-1980s and late 1990s, the rise of boy bands and girl groups, and the reintroduction of the vocoder and similar such innovations.", "url": null, "artists": [{"artist": "Justin Bieber", "streams": 12303, "best_position": 77}, {"artist": "Ariana Grande", "streams": 10912, "best_position": 95}, {"artist": "AD\u00c9LA", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Katy Perry", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}, {"artist": "Maroon 5", "streams": null, "best_position": null}, {"artist": "Michael Jackson", "streams": null, "best_position": null}]}, "electronic": {"genre": "electronic", "country_code": "il", "country_name": "Israel", "summary": "Electronic music refers to music that emphasizes the use of electronic musical instruments or electronic music technology as a central aspect of the sound of the music. Historically, electronic music was considered to be any music created with the use of electronic musical instruments or electronic processing, but in modern times, that distinction has been lost because almost all recorded music today, and the majority of live music performances, depend on extensive use of electronics.", "url": null, "artists": [{"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Cigarettes After Sex", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Depeche Mode", "streams": null, "best_position": null}, {"artist": "Eminem", "streams": null, "best_position": null}, {"artist": "Gorillaz", "streams": null, "best_position": null}, {"artist": "Kendrick Lamar", "streams": null, "best_position": null}]}, "grunge": {"genre": "grunge", "country_code": "il", "country_name": "Israel", "summary": "Grunge is a subgenre of rock music that emerged during the mid-1980s in the American state of Washington, almost entirely in the Seattle area. \"Grunge\" was initially used to describe only the emerging music scene in Seattle; an unkempt collective of bands each with their own scuzzy take on 70s rock that was a reaction against the technicality and pretension of contemporary and dominant metal. Inspired by hardcore punk, metal (particularly 70s heavy metal like Sabbath and Led Zep and the overdriven proto-punk of the Stooges), and early alt.", "url": null, "artists": [{"artist": "Alice in Chains", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Evanescence", "streams": null, "best_position": null}, {"artist": "Foo Fighters", "streams": null, "best_position": null}, {"artist": "Maroon 5", "streams": null, "best_position": null}, {"artist": "Muse", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "Radiohead", "streams": null, "best_position": null}]}, "hip-hop": {"genre": "hip-hop", "country_code": "il", "country_name": "Israel", "summary": "Hip-Hop, also spelled Hip Hop or HipHop is a rhythm focused popular music style, originating from New York in The 70s. The term rap is sometimes used synonymously with Hip-Hop music. Hip-hop arose when DJs began isolating the percussion break from funk or disco songs for audiences to dance to.\nIt is now seen as a worldwide and popular genre ranging from American Mainstream (e.g. Eminem, Lil Wayne) to British Underground (e.g. Wiley, EMC Junkie ect).", "url": null, "artists": [{"artist": "Justin Bieber", "streams": 12303, "best_position": 77}, {"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "Baby Keem", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Childish Gambino", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Don Toliver", "streams": null, "best_position": null}, {"artist": "Drake", "streams": null, "best_position": null}, {"artist": "Eminem", "streams": null, "best_position": null}, {"artist": "Frank Ocean", "streams": null, "best_position": null}, {"artist": "Future", "streams": null, "best_position": null}]}, "jazz": {"genre": "jazz", "country_code": "il", "country_name": "Israel", "summary": "Jazz is a musical art form which originated around the beginning of the 20th century in Black communities in the Southern United States from a confluence of African and European music traditions. The style's West African pedigree is evident in its use of blue notes, call-and-response, improvisation, polyrhythms, syncopation, and the swung note of ragtime.\n\nFrom its early development until the present, jazz has also incorporated music from 19th and 20th century American popular music, which is based on European music traditions.", "url": null, "artists": [{"artist": "Kendrick Lamar", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Laufey", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}, {"artist": "Sade", "streams": null, "best_position": null}, {"artist": "Steve Lacy", "streams": null, "best_position": null}]}, "metal": {"genre": "metal", "country_code": "il", "country_name": "Israel", "summary": "A metal is a material that exhibits a lustrous appearance when polished or fractured and conducts electricity and heat relatively efficiently. These properties are associated with the presence of electrons at the Fermi level. Metals are typically ductile, allowing them to be drawn into wires, and malleable, enabling them to be shaped by hammering or pressing.\n\nA metal may be a chemical element, such as iron, an alloy such as stainless steel, or a molecular compound such as polymeric sulfur nitride.", "url": null, "artists": [{"artist": "Alice in Chains", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Evanescence", "streams": null, "best_position": null}, {"artist": "Linkin Park", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": 