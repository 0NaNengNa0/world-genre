reams": null, "best_position": null}, {"artist": "Katy Perry", "streams": null, "best_position": null}]}, "hip-hop": {"genre": "hip-hop", "country_code": "za", "country_name": "South Africa", "summary": "Hip-Hop, also spelled Hip Hop or HipHop is a rhythm focused popular music style, originating from New York in The 70s. The term rap is sometimes used synonymously with Hip-Hop music. Hip-hop arose when DJs began isolating the percussion break from funk or disco songs for audiences to dance to.\nIt is now seen as a worldwide and popular genre ranging from American Mainstream (e.g. Eminem, Lil Wayne) to British Underground (e.g. Wiley, EMC Junkie ect).", "url": null, "artists": [{"artist": "Jhen\u00e9 Aiko", "streams": 121860, "best_position": 6}, {"artist": "Miguel", "streams": 30481, "best_position": 24}, {"artist": "Drake", "streams": 19959, "best_position": 72}, {"artist": "Mac Miller", "streams": 19517, "best_position": 73}, {"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "Baby Keem", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Bryson Tiller", "streams": null, "best_position": null}, {"artist": "Childish Gambino", "streams": null, "best_position": null}, {"artist": "Chris Brown", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Don Toliver", "streams": null, "best_position": null}]}, "jazz": {"genre": "jazz", "country_code": "za", "country_name": "South Africa", "summary": "Jazz is a musical art form which originated around the beginning of the 20th century in Black communities in the Southern United States from a confluence of African and European music traditions. The style's West African pedigree is evident in its use of blue notes, call-and-response, improvisation, polyrhythms, syncopation, and the swung note of ragtime.\n\nFrom its early development until the present, jazz has also incorporated music from 19th and 20th century American popular music, which is based on European music traditions.", "url": null, "artists": [{"artist": "Kendrick Lamar", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Laufey", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}, {"artist": "Sade", "streams": null, "best_position": null}, {"artist": "Steve Lacy", "streams": null, "best_position": null}]}, "neo soul": {"genre": "neo soul", "country_code": "za", "country_name": "South Africa", "summary": "Neo soul (also written neo-soul) is a subgenre of soul, usually blending a hybrid of 1970s-influenced soul music with influences from jazz, funk, hip-hop & electronica. It may also include influences from African, Asian, Latin, rock-n-roll and house music, depending on the artist.", "url": null, "artists": [{"artist": "Jhen\u00e9 Aiko", "streams": 121860, "best_position": 6}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Brent Faiyaz", "streams": null, "best_position": null}, {"artist": "Childish Gambino", "streams": null, "best_position": null}, {"artist": "Daniel Caesar", "streams": null, "best_position": null}, {"artist": "Justin Timberlake", "streams": null, "best_position": null}, {"artist": "Kali Uchis", "streams": null, "best_position": null}, {"artist": "Ravyn Lenae", "streams": null, "best_position": null}, {"artist": "SZA", "streams": null, "best_position": null}]}, "pop": {"genre": "pop", "country_code": "za", "country_name": "South Africa", "summary": "Pop music is a broad-term for many different types of music: The term is flexible, and the music labeled \"pop\" changes frequently. It usually refers to popular, appealing and mostly mainstream music with emphasis on catchy melodies and an accessible style, with songs that tend to have a short to medium length. Some subgenres may include synthpop, electropop, bubblegum, sophisti-pop, hyperpop and many others.", "url": null, "artists": [{"artist": "Jhen\u00e9 Aiko", "streams": 121860, "best_position": 6}, {"artist": "Miguel", "streams": 30481, "best_position": 24}, {"artist": "Drake", "streams": 19959, "best_position": 72}, {"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "AD\u00c9LA", "streams": null, "best_position": null}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "Ariana Grande", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Bruno Mars", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Chappell Roan", "streams": null, "best_position": null}]}, "r&b": {"genre": "r&b", "country_code": "za", "country_name": "South Africa", "summary": "R&B is a musical genre that began to develop as a distinct style in the early 1950s. Originally known as rhythm and blues, it was primarily created by African American musicians and drew influence from both blues and early rock 'n' roll, with significant interaction between these genres. Over time, musicians from different backgrounds adopted the style and introduced new elements. In the 1950s, artists like Muddy Waters contributed to shaping the genre by emphasizing faster melodies and energetic rhythms.", "url": null, "artists": [{"artist": "Jhen\u00e9 Aiko", "streams": 121860, "best_position": 6}, {"artist": "Miguel", "streams": 30481, "best_position": 24}, {"artist": "Drake", "streams": 19959, "best_position": 72}, {"artist": "Ariana Grande", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Brent Faiyaz", "streams": null, "best_position": null}, {"artist": "Bruno Mars"