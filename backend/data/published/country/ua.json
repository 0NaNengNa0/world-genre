rnative", "country_code": "ua", "country_name": "Ukraine", "summary": "Alternative refers to artists that do not follow the mainstream sounds generally heard on the radio or in media.  The genre of Alternative includes Jangle Pop, Noise Rock, Trip-Hop, Industrial, Grunge, Shoegaze, New Wave and some of the more eclectic Punk, Post-Punk, and Hardcore Punk bands, among other genres. Most Alternative bands in this wave were largely underground although some became cult hits like Pixies, The Replacements, and The Smiths.", "url": null, "artists": [{"artist": "Tame Impala", "streams": 24641, "best_position": 5}, {"artist": "The Neighbourhood", "streams": 17069, "best_position": 35}, {"artist": "Arctic Monkeys", "streams": 16756, "best_position": 33}, {"artist": "Alice in Chains", "streams": null, "best_position": null}, {"artist": "Bad Omens", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Bladee", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Cocteau Twins", "streams": null, "best_position": null}, {"artist": "Coldplay", "streams": null, "best_position": null}, {"artist": "Crystal Castles", "streams": null, "best_position": null}]}, "classic rock": {"genre": "classic rock", "country_code": "ua", "country_name": "Ukraine", "summary": "Classic rock was originally conceived as a radio station programming format which evolved from the album oriented rock (AOR) format in the early-1980s. In the United States, this rock music format now features a large playlist of songs ranging from the 1960s, 1970s, 1980s and early 1990s, with some stations including a limited number of current releases.\n\nThe classic rock stations recreate the sound of Album Oriented Rock (AOR) stations of the 60s-90s (although usually with a much more limited playlist) and appeal mainly to adults.", "url": null, "artists": [{"artist": "Black Sabbath", "streams": null, "best_position": null}, {"artist": "David Bowie", "streams": null, "best_position": null}, {"artist": "Led Zeppelin", "streams": null, "best_position": null}, {"artist": "Pink Floyd", "streams": null, "best_position": null}, {"artist": "Queen", "streams": null, "best_position": null}, {"artist": "Scorpions", "streams": null, "best_position": null}, {"artist": "The Beatles", "streams": null, "best_position": null}]}, "cloud rap": {"genre": "cloud rap", "country_code": "ua", "country_name": "Ukraine", "summary": "Cloud rap refers to a form of hip hop, whose distinguishing features include ethereal, dreamlike beats (which often use wordless vocal samples, wherein singers harmonize or hold long notes, to produce a majestic effect) and abstracted, sometimes deliberately absurd lyrics.\n\nThe mannerisms of cloud rap vocalists have produced several catchphrases, which listeners commonly associate with the genre, such as the interjection \"swag\" and references to being \"based\".", "url": null, "artists": [{"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "Bladee", "streams": null, "best_position": null}, {"artist": "Lil Peep", "streams": null, "best_position": null}, {"artist": "Playboi Carti", "streams": null, "best_position": null}, {"artist": "Yeat", "streams": null, "best_position": null}, {"artist": "Yung Lean", "streams": null, "best_position": null}]}, "dance-pop": {"genre": "dance-pop", "country_code": "ua", "country_name": "Ukraine", "summary": "Dance-pop is a style of electronic dance music and a subgenre of pop music that evolved from Disco, circa 1981, that combines dance beats with a pop/R'n'B song structure. Because there is such an emphasis on fully-formed songs in dance-pop, it's often viewed as a separate classification unto itself apart from pure dance. Dance-pop is also closely related to the teen pop and Eurodance movements in the mid-1980s and late 1990s, the rise of boy bands and girl groups, and the reintroduction of the vocoder and similar such innovations.", "url": null, "artists": [{"artist": "Michael Jackson", "streams": 7785, "best_position": 65}, {"artist": "AD\u00c9LA", "streams": null, "best_position": null}, {"artist": "Ariana Grande", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Dua Lipa", "streams": null, "best_position": null}, {"artist": "Katy Perry", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}, {"artist": "Miley Cyrus", "streams": null, "best_position": null}, {"artist": "PinkPantheress", "streams": null, "best_position": null}]}, "electronic": {"genre": "electronic", "country_code": "ua", "country_name": "Ukraine", "summary": "Electronic music refers to music that emphasizes the use of electronic musical instruments or electronic music technology as a central aspect of the sound of the music. Historically, electronic music was considered to be any music created with the use of electronic musical instruments or electronic processing, but in modern times, that distinction has been lost because almost all recorded music today, and the majority of live music performances, depend on extensive use of electronics.", "url": null, "artists": [{"artist": "Arctic Monkeys", "streams": 16756, "best_position": 33}, {"artist": "Michael Jackson", "streams": 7785, "best_position": 65}, {"artist": "BTS", "streams": 7724, "best_position": 66}, {"artist": "Aphex Twin", "streams": null, "best_position": null}, {"artist": "Bad Omens", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Crystal Castles", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}]}, "grunge": {"genre": "grunge", "country_code": "ua", "country_name": "Ukraine", "summary": "Grunge is a subgenre of rock music that emerged during the mid-1980s in the American state of Washington, almost entirely in the Seattle area. \"Grunge\" was initially used to describe only the emerging music scene in Seattle; an unkempt collective of bands each with their own scuzzy take on 70s rock that was a reaction against the technicality and pretension of contemporary and dominant metal. Inspired by hardcore punk, metal (particularly 70s heavy metal like Sabbath and Led Zep and the overdriven proto-punk of the Stooges), and early alt.", "url": null, "artists": [{"artist": "Alice in Chains", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Evanescence", "streams": null, "best_position": null}, {"artist": "Muse", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "Radiohead", "streams": null, "best_position": null}, {"artist": "The Smashing Pumpkins", "streams": null, "best_position": null}, {"artist": "Three Days Grace", "streams": null, "best_position": null}]}, "hard rock": {"genre": "hard rock", "country_code": "ua", "country_name": "Ukraine", "summary": "Hard rock is a loosely defined genre of rock music which has its earliest roots in mid-1960s garage, blues rock and psychedelic rock. It is typified by a heavy use of distorted electric guitars, bass guitar, drums, pianos, and keyboards.\n\nOne of the major influences of hard rock is blues music. American and British rock bands began to modify rock and roll, adding to the standard genre harder sounds, heavier guitar riffs, bombastic drumming and louder vocals.", "url": null, "artists": [{"artist": "Alice in Chains", "streams": null, "best_position": null}, {"artist": "Black Sabbath", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Disturbed", "streams": null, "best_position": null}, {"artist": "Led Zeppelin", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "My Chemical Romance", "streams": null, "best_position": null}, {"artist": "Queen", "streams": null, "best_position": null}, {"artist": "Queens of the Stone Age", "streams": null, "best_position": null}, {"artist": "Scorpions", "streams": null, "best_position": null}, {"artist": "System of a Down", "streams": null, "best_position": null}, {"artist": "Three Days Grace", "streams": null, "best_position": null}]}, "heavy metal": {"genre": "heavy metal", "country_code": "ua", "country_name": "Ukraine", "summary": "Heavy metal (often referred to simply as metal) is a genre of rock music that developed in the late 1960s and early 1970s, largely in the United Kingdom and the United States. Today, the original genre is often referred to as classic metal or traditional heavy metal.\n\nWith roots in blues-rock and psychedelic rock, the bands that created heavy metal developed a thick, massive sound, characterized by highly amplified distortion, extended guitar solos, emphatic beats, and overall loudness.", "url": null, "artists": [{"artist": "Alice in Chains", "streams": null, "best_position": null}, {"artist": "Black Sabbath", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Disturbed", "streams": null, "best_position": null}, {"artist": 