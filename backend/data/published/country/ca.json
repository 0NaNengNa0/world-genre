ion": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Cigarettes After Sex", "streams": null, "best_position": null}]}, "electropop": {"genre": "electropop", "country_code": "ca", "country_name": "Canada", "summary": "Electropop is a type of electronic pop music which features crackly synthesizers prominently in the mix.   Electropop has become an increasingly common term for this music post-2000 whereas in earlier years, synthpop was probably the more common term for pop music using synthesizers.\n\nWhen Kraftwerk first appeared in the mid-1970's, their music was described as electronic body music (ebm) in Germany, Krautrock in England, and technopop in Japan.", "url": null, "artists": [{"artist": "AD\u00c9LA", "streams": 211276, "best_position": 4}, {"artist": "Taylor Swift", "streams": 115349, "best_position": 61}, {"artist": "Katy Perry", "streams": 62782, "best_position": 59}, {"artist": "Rihanna", "streams": 56250, "best_position": 80}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Chappell Roan", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Fall Out Boy", "streams": null, "best_position": null}, {"artist": "Gorillaz", "streams": null, "best_position": null}]}, "folk": {"genre": "folk", "country_code": "ca", "country_name": "Canada", "summary": "Folk music can have a number of different meanings, including:\n\nTraditional music: The original meaning of the term \"folk music\" was synonymous with the term \"Traditional music\", also often including Roots music; the term \"Traditional music\" was given its more specific meaning to distinguish it from the other definitions that \"Folk music\" is now considered to encompass.\nFolk music can also describe a particular kind of popular music which is based on traditional music.", "url": null, "artists": [{"artist": "Olivia Rodrigo", "streams": 264296, "best_position": 8}, {"artist": "Taylor Swift", "streams": 115349, "best_position": 61}, {"artist": "Alex G", "streams": null, "best_position": null}, {"artist": "Clairo", "streams": null, "best_position": null}, {"artist": "Lorde", "streams": null, "best_position": null}, {"artist": "Mac DeMarco", "streams": null, "best_position": null}, {"artist": "Phoebe Bridgers", "streams": null, "best_position": null}]}, "grunge": {"genre": "grunge", "country_code": "ca", "country_name": "Canada", "summary": "Grunge is a subgenre of rock music that emerged during the mid-1980s in the American state of Washington, almost entirely in the Seattle area. \"Grunge\" was initially used to describe only the emerging music scene in Seattle; an unkempt collective of bands each with their own scuzzy take on 70s rock that was a reaction against the technicality and pretension of contemporary and dominant metal. Inspired by hardcore punk, metal (particularly 70s heavy metal like Sabbath and Led Zep and the overdriven proto-punk of the Stooges), and early alt.", "url": null, "artists": [{"artist": "Radiohead", "streams": 60542, "best_position": 64}, {"artist": "Foo Fighters", "streams": 57587, "best_position": 76}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Maroon 5", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "The Smashing Pumpkins", "streams": null, "best_position": null}]}, "hip-hop": {"genre": "hip-hop", "country_code": "ca", "country_name": "Canada", "summary": "Hip-Hop, also spelled Hip Hop or HipHop is a rhythm focused popular music style, originating from New York in The 70s. The term rap is sometimes used synonymously with Hip-Hop music. Hip-hop arose when DJs began isolating the percussion break from funk or disco songs for audiences to dance to.\nIt is now seen as a worldwide and popular genre ranging from American Mainstream (e.g. Eminem, Lil Wayne) to British Underground (e.g. Wiley, EMC Junkie ect).", "url": null, "artists": [{"artist": "Drake", "streams": 231335, "best_position": 3}, {"artist": "Justin Bieber", "streams": 131433, "best_position": 33}, {"artist": "Post Malone", "streams": 126722, "best_position": 52}, {"artist": "Mac Miller", "streams": 90502, "best_position": 17}, {"artist": "Don Toliver", "streams": 64512, "best_position": 54}, {"artist": "Michael Jackson", "streams": 64130, "best_position": 55}, {"artist": "Rihanna", "streams": 56250, "best_position": 80}, {"artist": "PARTYNEXTDOOR", "streams": 53931, "best_position": 95}, {"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Childish Gambino", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}]}, "jazz": {"genre": "jazz", "country_code": "ca", "country_name": "Canada", "summary": "Jazz is a musical art form which originated around the beginning of the 20th century in Black communities in the Southern United States from a confluence of African and European music traditions. The style's West African pedigree is evident in its use of blue notes, call-and-response, improvisation, polyrhythms, syncopation, and the swung note of ragtime.\n\nFrom its early development until the present, jazz has also incorporated music from 19th and 20th century American popular music, which is based on European music traditions.", "url": null, "artists": [{"artist": "Steve Lacy", "streams": 93300, "best_position": 13}, {"artist": "Kendrick Lamar", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Laufey", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}]}, "pop": {"genre": "pop", "country_code": "ca", "country_name": "Canada", "summary": "Pop music is a broad-term for many different types of music: The term is flexible, and the music labeled \"pop\" changes frequently. It usually refers to popular, appealing and mostly mainstream music with emphasis on catchy melodies and an accessible style, with songs that tend to have a short to medium length. Some subgenres may include synthpop, electropop, bubblegum, sophisti-pop, hyperpop and many others.", "url": null, "artists": [{"artist": "Olivia Rodrigo", "streams": 264296, "best_position": 8}, {"artist": "Drake", "streams": 231335, "best_position": 3}, {"artist": "AD\u00c9LA", "streams": 211276, "best_position": 4}, {"artist": "Malcolm Todd", "streams": 132425, "best_position": 2}, {"artist": "Justin Bieber", "streams": 131433, "best_position": 33}, {"artist": "Post Malone", "streams": 126722, "best_position": 52}, {"artist": "Coldplay", "streams": 119800, "best_position": 51}, {"artist": "Taylor Swift", "streams": 115349, "best_position": 61}, {"artist": "Tame Impala", "streams": 113198, "best_position": 5}, {"artist": "Ariana Grande", "streams": 86318, "best_position": 20}, {"artist": "Dominic Fike", "streams": 82774, "best_position": 24}, {"artist": "Arctic Monkeys", "streams": 64542, "best_position": 53}]}, "pop punk": {"genre": "pop punk", "country_code": "ca", "country_name": "Canada", "summary": "Pop punk (also known as punk pop and other names) is a fusion genre that combines elements of punk rock with pop music, to varying degrees.\n\nIt is not clear when the term pop punk was first used, but pop-influenced punk rock had been around since the 1970s; performed by bands such as the Ramones, Buzzcocks, The Jam, The Undertones, and Generation X. Bad Religion, who started in 1980, were another early band to play the genre, and some consider them godfathers of pop punk.", "url": null, "a