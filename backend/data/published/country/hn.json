ance-pop": {"genre": "dance-pop", "country_code": "hn", "country_name": "Honduras", "summary": "Dance-pop is a style of electronic dance music and a subgenre of pop music that evolved from Disco, circa 1981, that combines dance beats with a pop/R'n'B song structure. Because there is such an emphasis on fully-formed songs in dance-pop, it's often viewed as a separate classification unto itself apart from pure dance. Dance-pop is also closely related to the teen pop and Eurodance movements in the mid-1980s and late 1990s, the rise of boy bands and girl groups, and the reintroduction of the vocoder and similar such innovations.", "url": null, "artists": [{"artist": "AD\u00c9LA", "streams": null, "best_position": null}, {"artist": "Ariana Grande", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Black Eyed Peas", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Dua Lipa", "streams": null, "best_position": null}, {"artist": "Justin Bieber", "streams": null, "best_position": null}, {"artist": "KATSEYE", "streams": null, "best_position": null}, {"artist": "Katy Perry", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}]}, "electronic": {"genre": "electronic", "country_code": "hn", "country_name": "Honduras", "summary": "Electronic music refers to music that emphasizes the use of electronic musical instruments or electronic music technology as a central aspect of the sound of the music. Historically, electronic music was considered to be any music created with the use of electronic musical instruments or electronic processing, but in modern times, that distinction has been lost because almost all recorded music today, and the majority of live music performances, depend on extensive use of electronics.", "url": null, "artists": [{"artist": "Rauw Alejandro", "streams": 11380, "best_position": 94}, {"artist": "BTS", "streams": 10713, "best_position": 9}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "Belanova", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Cigarettes After Sex", "streams": null, "best_position": null}, {"artist": "Daddy Yankee", "streams": null, "best_position": null}, {"artist": "Dua Lipa", "streams": null, "best_position": null}]}, "electropop": {"genre": "electropop", "country_code": "hn", "country_name": "Honduras", "summary": "Electropop is a type of electronic pop music which features crackly synthesizers prominently in the mix.   Electropop has become an increasingly common term for this music post-2000 whereas in earlier years, synthpop was probably the more common term for pop music using synthesizers.\n\nWhen Kraftwerk first appeared in the mid-1970's, their music was described as electronic body music (ebm) in Germany, Krautrock in England, and technopop in Japan.", "url": null, "artists": [{"artist": "AD\u00c9LA", "streams": null, "best_position": null}, {"artist": "Belanova", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Dua Lipa", "streams": null, "best_positi