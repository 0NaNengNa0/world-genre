b": {"genre": "r&b", "country_code": "no", "country_name": "Norway", "summary": "R&B is a musical genre that began to develop as a distinct style in the early 1950s. Originally known as rhythm and blues, it was primarily created by African American musicians and drew influence from both blues and early rock 'n' roll, with significant interaction between these genres. Over time, musicians from different backgrounds adopted the style and introduced new elements. In the 1950s, artists like Muddy Waters contributed to shaping the genre by emphasizing faster melodies and energetic rhythms.", "url": null, "artists": [{"artist": "Zara Larsson", "streams": 34873, "best_position": 39}, {"artist": "Malcolm Todd", "streams": 22599, "best_position": 32}, {"artist": "Ariana Grande", "streams": 20263, "best_position": 42}, {"artist": "Justin Bieber", "streams": 17418, "best_position": 49}, {"artist": "Michael Jackson", "streams": 17241, "best_position": 50}, {"artist": "Dua Lipa", "streams": 14136, "best_position": 72}, {"artist": "Steve Lacy", "streams": 14020, "best_position": 74}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Bruno Mars", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}]}, "rock": {"genre": "rock", "country_code": "no", "country_name": "Norway", "summary": "Rock music is a form of popular music with a prominent vocal melody, accompanied by guitar, drums, and bass. Many styles of rock music also use keyboard instruments such as organ, piano, mellotron, and synthesizers. Other instruments sometimes utilized in rock include saxophone, harmonica, violin, flute, French horn, banjo, melodica, and timpani. Also, less common stringed instruments such as mandolin and sitar are used. Rock music usually has a strong back beat.", "url": null, 