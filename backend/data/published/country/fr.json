ry_name": "France", "summary": "Rock music is a form of popular music with a prominent vocal melody, accompanied by guitar, drums, and bass. Many styles of rock music also use keyboard instruments such as organ, piano, mellotron, and synthesizers. Other instruments sometimes utilized in rock include saxophone, harmonica, violin, flute, French horn, banjo, melodica, and timpani. Also, less common stringed instruments such as mandolin and sitar are used. Rock music usually has a strong back beat.", "url": null, "artists": [{"artist": "Tame Impala", "streams": 125984, "best_position": 33}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Bruno Mars", "streams": null, "best_position": null}, {"artist": "Coldplay", "streams": null, "best_position": null}, {"artist": "David Bowie", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Fleetwood Mac", "streams": null, "best_position": null}, {"artist": "Gorillaz", "streams": null, "best_position": null}, {"artist": "Green Day", "streams": null, "best_position": null}, {"artist": "Harry Styles", "streams": null, "best_position": null}, {"artist": "Imagine Dragons", "streams": null, "best_position": null}]}, "soul": {"genre": "soul", "country_code": "fr", "country_name": "France", "summary": "Soul music is a music genre that combines rhythm and blues and gospel music, originating in the United States.  According to the Rock and Roll Hall of Fame, soul is \"music that arose out of the black experience in America through the transmutation of gospel and rhythm & blues into a form of funky, secular testifying.\" The genre occasionally uses improvisational additions, twirls and auxiliary sounds. Catchy rhythms, stressed by handclaps and plastic body moves, are an important feature.", "url": null, "artists": [{"artist": "Ang\u00e8le", "streams": null, "best_position": 