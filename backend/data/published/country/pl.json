fide", "streams": 44452, "best_position": 85}, {"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "Bedoes 2115", "streams": null, "best_position": null}]}, "metal": {"genre": "metal", "country_code": "pl", "country_name": "Poland", "summary": "A metal is a material that exhibits a lustrous appearance when polished or fractured and conducts electricity and heat relatively efficiently. These properties are associated with the presence of electrons at the Fermi level. Metals are typically ductile, allowing them to be drawn into wires, and malleable, enabling them to be shaped by hammering or pressing.\n\nA metal may be a chemical element, such as iron, an alloy such as stainless steel, or a molecular compound such as polymeric sulfur nitride.", "url": null, "artists": [{"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Limp Bizkit", "streams": null, "best_position": null}, {"artist": "Linkin Park", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "Rammstein", "streams": null, "best_position": null}, {"artist": "Red Hot Chili Peppers", "streams": null, "best_position": null}, {"artist": "Slipknot", "streams": null, "best_position": null}, {"artist": "System of a Down", "streams": null, "best_position": null}]}, "new wave": {"genre": "new wave", "country_code": "pl", "country_name": "Poland", "summary": "New wave is today a quite broad umbrella term describing popular music from around 1977 to 1986. But originally it was a slim sub genre of Western popular music that arose in the United Kingdom about 1977-78. It had close ties to punk rock and fairly strong influences of the musical style that had been invented and continuously developed throughout the 1970s: reggae.\n\nThe term new wave was first a kind of description of a more musical and lyric wise complex music than punk.", "url": null, "artists": [{"artist": "David Bowie", "streams": null, "best_position": null}, {"artist": "Depeche Mode", "streams": null, "best_position": null}, {"artist": "Fontaines D.C.", "streams": null, "best_position": null}, {"artist": "Maanam", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}, {"artist": "Paramore", "streams": null, "best_position": null}, {"artist": "The Cure", "streams": null, "best_position": null}, {"artist": "The Smiths", "streams": null, "best_position": null}]}, "nu metal": {"genre": "nu metal", "country_code": "pl", "country_name": "Poland", "summary": "Nu metal is a subgenre of alternative metal that blends elements of heavy metal with influences from other genres such as hip hop, funk, industrial, and grunge. It typically emphasises rhythm and syncopation, with guitar work often involving down-tuned seven-string guitars to create a heavier sound. Guitar solos and technical displays are generally less common in nu metal. Vocal styles vary and may include singing, rapping, screaming, and occasionally growling.", "url": null, "artists": [{"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Limp Bizkit", "streams": null, "best_position": null}, {"artist": "Linkin Park", "streams": null, "best_position": null}, {"artist": "Slipknot", "streams": null, "best_position": null}, {"artist": "System of a Down", "streams": null, "best_position": null}]}, "pop": {"genre": "pop", "country_code": "pl", "country_name": "Poland", "summary": "Pop music is a broad-term for many different types of music: The term is flexible, and the music labeled \"pop\" changes frequently. It usually refers to popular, appealing and mostly mainstream music with emphasis on catchy melodies and an accessible style, with songs that tend to have a short to mediu