A", "streams": 107023, "best_position": 45}, {"artist": "Katy Perry", "streams": 90207, "best_position": 69}, {"artist": "Dua Lipa", "streams": 42134, "best_position": 97}, {"artist": "Ariana Grande", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Black Eyed Peas", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Chappell Roan", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "David Guetta", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}]}, "electro": {"genre": "electro", "country_code": "pl", "country_name": "Poland", "summary": "Electro is a type of electronic dance music which emerged with the development of early sampling technology and the introduction of the Roland TR-808 drum machine and is closely associated with Hip Hop's formative years in the early to mid 1980s. It is not to be confused with electro house, which is commonly shortened to just \"electro\" in EDM circles. The electro style is defined by the 808 and 808 drum samples arranged in syncopated rhythm patterns often resembling the Funk breaks used in Hip Hop  beats with simple, funky basslines.", "url": null, "artists": [{"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Crystal Castles", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "David Guetta", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Rihanna", "streams": null, "best_position": null}]}, "electronic": {"genre": "electronic", "country_code": "pl", "country_name": "Poland", "summary": "Electronic music refers to music that emphasizes the use of electronic musical instruments or electronic music technology as a central aspect of the sound of the music. Historically, electronic music was considered to be any music created with the use of electronic musical instruments or electronic processing, but in modern times, that distinction has been lost because almost all recorded music today, and the majority of live music performances, depend on extensive use of electronics.", "url": null, "artists": [{"artist": "Dua Lipa", "streams": 42134, "best_position": 97}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Crystal Castles", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "David Guetta", "streams": null, "best_position": null}, {"artist": "Depeche Mode", "streams": null, "best_position": null}]}, "electropop": {"genre": "electropop", "country_code": "pl", "country_name": "Poland", "summary": "Electropop is a type of electronic pop music which features crackly synthesizers prominently in the mix.   Electropop has become an increasingly common term for this music post-2000 whereas in earlier years, synthpop was probably the more common term for pop music using synthesizers.\n\nWhen Kraftwerk first appeared in the mid-1970's, their music was described as electronic body music (ebm) in Germany, Krautrock in England, and technopop in Japan.", "url": null, "arti