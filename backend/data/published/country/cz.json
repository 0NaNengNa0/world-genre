n": null}, {"artist": "Depeche Mode", "streams": null, "best_position": null}, {"artist": "Ellie Goulding", "streams": null, "best_position": null}, {"artist": "Eminem", "streams": null, "best_position": null}]}, "electropop": {"genre": "electropop", "country_code": "cz", "country_name": "Czechia", "summary": "Electropop is a type of electronic pop music which features crackly synthesizers prominently in the mix.   Electropop has become an increasingly common term for this music post-2000 whereas in earlier years, synthpop was probably the more common term for pop music using synthesizers.\n\nWhen Kraftwerk first appeared in the mid-1970's, their music was described as electronic body music (ebm) in Germany, Krautrock in England, and technopop in Japan.", "url": null, "artists": [{"artist": "AD\u00c9LA", "streams": 78444, "best_position": 4}, {"artist": "Katy Perry", "streams": 40983, "best_position": 32}, {"artist": "Dua Lipa", "streams": 17000, "best_position": 55}, {"artist": "Taylor Swift", "streams": 13832, "best_position": 96}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "David Guetta", "streams": null, "best_position": null}, {"artist": "Ellie Goulding", "streams": null, "best_position": null}, {"artist": "Fall Out Boy", "streams": null, "best_position": null}, {"artist": "Gorillaz", "streams": null, "best_position": null}]}, "grunge": {"genre": "grunge", "country_code": "cz", "country_name": "Czechia", "summary": "Grunge is a subgenre of rock music that emerged during the mid-1980s in the American state of Washington, almost entirely in the Seattle area. \"Grunge\" was initially used to describe only the emerging music scene in Seattle; an unkempt collective of bands each with their own scuzzy take on 70s rock that was a reaction against the technicality and pretension of contemporary and dominant metal. Inspired by hardcore punk, metal (particularly 70s heavy metal like Sabbath and Led Zep and the overdriven proto-punk of the Stooges), and early alt.", "url": null, "artists": [{"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Evanescence", "streams": null, "best_position": null}, {"artist": "Foo Fighters", "streams": null, "best_position": null}, {"artist": "Muse", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "Radiohead", "streams": null, "best_position": null}, {"artist": "The Offspring", "streams": null, "best_position": null}, {"artist": "The Smashing Pumpkins", "streams": null, "best_position": null}, {"artist": "Three Days Grace", "streams": null, "best_position": null}]}, "hip-hop": {"genre": "hip-hop", "country_code": "cz", "country_name": "Czechia", "summary": "Hip-Hop, also spelled Hip Hop or HipHop is a rhythm focused popular music style, originating from New York in The 70s. The term rap is sometimes used synonymously with Hip-Hop music. Hip-hop arose when DJs began isolating the percussion break from funk or disco songs for audiences to dance to.\nIt is now seen as a worldwide and popular genre ranging from American Mainstream (e.g. Eminem, Lil Wayne) to British Underground (e.g. Wiley, EMC Junkie ect).", "url": null, "artists": [{"artist": "Yzomandias", "streams": 355708, "best_position": 9}, {"artist": "Calin", "streams": 336458, "best_position": 2}, {"artist": "Viktor Sheen", "streams": 125292, "best_position": 42}, {"artist": "Justin Bieber", "streams": 20966, "best_position": 30}, {"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "Black Eyed Peas", "streams": null, "best_position": null}, {"artist": "Childish Gambino", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Drake", "streams": null, "best_position": null}, {"artist": "Eminem", "streams": null, "best_position": null}, {"artist": "Future", "streams": null, "best_position": null}]}, "industrial": {"genre": "industrial", "country_code": "cz", "country_name": "Czechia", "summary": "Industrial music is a style of experimental music that draws on transgressive and provocative themes. The term was coined in the mid-1970s with the founding of Industrial Records by the band Throbbing Gristle, and the creation of the slogan \"industrial music for industrial people\". In general, the style is harsh and challenging. Allmusic defines industrial as the \"most abrasive and aggressive fusion of rock and electronic music\"; \"initially a blend of avant-garde electronics experiments tape music.", "url": null, "artists": [{"artist": "Depeche Mode", "streams": null, "best_position": null}, {"artist": "Nine Inch Nails", "streams": null, "best_position": null}, {"artist": "Rammstein", "streams": null, "best_position": null}]}, "metal": {"genre": "metal", "country_code": "cz", "country_name": "Czechia", "summary": "A metal is a material that exhibits a lustrous appearance when polished or fractured and conducts electricity and heat relatively efficiently. These properties are associated with the presence of electrons at the Fermi level. Metals are typically ductile, allowing them to be drawn into wires, and malleable, enabling them to be shaped by hammering or pressing.\n\nA metal may be a chemical element, such as iron, an alloy such as stainless steel, or a molecular compound such as polymeric sulfur nitride.", "url": null, "artists": [{"artist": "Linkin Park", "streams": 14277, "best_position": 90}, {"artist": "Bring Me the Horizon", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Evanescence", "streams": null, "best_position": null}, {"artist": "Korn", "streams": null, "best_position": null}, {"artist": "Limp Bizkit", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "Rammstein", "streams": null, "best_position": null}, {"artist": "Red Hot Chili Peppers", "streams": null, "best_position": null}, {"artist": "Slipknot", "streams": null, "best_position": null}, {"artist": "System of a Down", "streams": null, "best_position": null}]}, "new wave": {"genre": "new wave", "country_code": "cz", "country_name": "Czechia", "summary": "New wave is today a quite broad umbrella term describing popular music from around 1977 to 1986. But originally it was a slim sub genre of Western popular music that arose in the United Kingdom about 1977-78. It had close ties to punk rock and fairly strong influences of the musical style that had been invented and continuously developed throughout the 1970s: reggae.\n\nThe term new wave was first a kind of description of a more musical and lyric wise complex music than punk.", "url": null, "artists": [{"artist": "The Killers", "streams": 18887, "best_position": 39}, {"artist": "David Bowie", "streams": null, "best_position": null}, {"artist": "Depeche Mode", "streams": null, "best_position": null}, {"artist": "Fontaines D.C.", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}, {"artist": "Paramore", "streams": null, "best_position": null}, {"artist": "The Cure", "streams": null, "best_position": null}, {"artist": "The Smiths", "streams": null, "best_position": null}, {"artist": "The Strokes", "streams": null, "best_position": null}]}, "nu metal": {"genre": "nu metal", "country_code": "cz", "country_name": "Czechia", "summary": "Nu metal is a subgenre of alternative metal that blends elements of heavy metal with influences from other genres such as hip hop, funk, industrial, and grunge. It typically emphasises rhythm and syncopat