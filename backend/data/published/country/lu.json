t).", "url": null, "artists": [{"artist": "Justin Bieber", "streams": 1167, "best_position": 15}, {"artist": "Michael Jackson", "streams": 1066, "best_position": 21}, {"artist": "Mac Miller", "streams": 1002, "best_position": 26}, {"artist": "A$AP Rocky", "streams": null, "best_position": null}, {"artist": "Bad Bunny", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Black Eyed Peas", "streams": null, "best_position": null}, {"artist": "Childish Gambino", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Don Toliver", "streams": null, "best_position": null}, {"artist": "Drake", "streams": null, "best_position": null}]}, "metal": {"genre": "metal", "country_code": "lu", "country_name": "Luxembourg", "summary": "A metal is a material that exhibits a lustrous appearance when polished or fractured and conducts electricity and heat relatively efficiently. These properties are associated with the presence of electrons at the Fermi level. Metals are typically ductile, allowing them to be drawn into wires, and malleable, enabling them to be shaped by hammering or pressing.\n\nA metal may be a chemical element, such as iron, an alloy such as stainless steel, or a molecular compound such as polymeric sulfur nitride.", "url": null, "artists": [{"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Limp Bizkit", "streams": null, "best_position": null}, {"artist": "Linkin Park", "streams": null, "best_position": null}, {"artist": "Metallica", "streams": null, "best_position": null}, {"artist": "Nirvana", "streams": null, "best_position": null}, {"artist": "Red Hot Chili Peppers", "streams": null, "best_position": null}, {"artist": "Slipknot", "streams": null, "best_position": null}, {"artist": "System of a Down", "streams": null, "best_position": null}]}, "n