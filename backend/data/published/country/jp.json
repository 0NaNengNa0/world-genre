ams": 68401, "best_position": 89}, {"artist": "ASIAN KUNG-FU GENERATION", "streams": null, "best_position": null}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "BUMP OF CHICKEN", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Coldplay", "streams": null, "best_position": null}, {"artist": "David Bowie", "streams": null, "best_position": null}, {"artist": "Deftones", "streams": null, "best_position": null}, {"artist": "Doja Cat", "streams": null, "best_position": null}, {"artist": "Drake", "streams": null, "best_position": null}]}, "britpop": {"genre": "britpop", "country_code": "jp", "country_name": "Japan", "summary": "Britpop is a subgenre of alternative rock that originated in the United Kingdom. Britpop emerged from the British independent music scene of the early 1990s and was characterised by bands influenced by British guitar pop music of the 1960s and 1970s. The movement developed as a reaction against various musical and cultural trends in the late 1980s and early 1990s, particularly the grunge phenomenon from the United States. In the wake of the musical invasion into the United Kingdom of American grunge bands such as Nirvana.", "url": null, "artists": [{"artist": "Coldplay", "streams": null, "best_position": null}, {"artist": "Oasis", "streams": null, "best_position": null}, {"artist": "Radiohead", "streams": null, "best_position": null}, {"artist": "The Beatles", "streams": null, "best_position": null}, {"artist": "The Smiths", "streams": null, "best_position": null}]}, "classic rock": {"genre": "classic rock", "country_code": "jp", "country_name": "Japan", "summary": "Classic rock was originally conceived as a radio station programming format which evolved from the album oriented rock (AOR) format in the early-1980s. In the United States, this rock music format now features a large playlist of songs ranging from the 1960s, 1970s, 1980s and early 1990s, with some stations including a limited number of current releases.\n\nThe classic rock stations recreate the sound of Album Oriented Rock (AOR) stations of the 60s-90s (although usually with a much more limited playlist) and appeal mainly to adults.", "url": null, "artists": [{"artist": "David Bowie", "streams": null, "best_position": null}, {"artist": "Queen", "streams": null, "best_position": null}, {"artist": "The Beatles", "streams": null, "best_position": null}]}, "dance-pop": {"genre": "dance-pop", "country_code": "jp", "country_name": "Japan", "summary": "Dance-pop is a style of electronic dance music and a subgenre of pop music that evolved from Disco, circa 1981, that combines dance beats with a pop/R'n'B song structure. Because there is such an emphasis on fully-formed songs in dance-pop, it's often viewed as a separate classification unto itself apart from pure dance. Dance-pop is also closely related to the teen pop and Eurodance movements in the mid-1980s and late 1990s, the rise of boy bands and girl groups, and the reintroduction of the vocoder and similar such innovations.", "url": null, "artists": [{"artist": "AD\u00c9LA", "streams": null, "best_position": null}, {"artist": "Ariana Grande", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Justin Bieber", "streams": null, "best_position": null}, {"artist": "Katy Perry", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}, {"artist": "Maroon 5", "streams": null, "best_position": null}, {"artist": "Michael Jackson", "streams": null, "best_position": null}, {"artist": "PinkPantheress", "streams": null, "best_position": null}, {"artist": "Rihanna", "streams": null, "best_position": null}]}, "electronic": {"genre": "electronic", "country_code": "jp", "country_name": "Japan", "summary": "Electronic music refers to music that emphasizes the use of electronic musical instruments or electronic music technology as a central aspect of the sound of the music. Historically, electronic music was considered to be any music created with the use of electronic musical instruments or electronic processing, but in modern times, that distinction has been lost because almost all recorded music today, and the majority of live music performances, depend on extensive use of electronics.", "url": null, "artists": [{"artist": "ONE OK ROCK", "streams": 68401, "best_position": 89}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "BTS", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Gorillaz", "streams": null, "best_position": null}, {"artist": "Kendrick Lamar", "streams": null, "best_position": null}, {"artist": "Lady Gaga", "streams": null, "best_position": null}, {"artist": "Lana Del Rey", "streams": null, "best_position": null}, {"artist": "Madonna", "streams": null, "best_position": null}]}, "electropop": {"genre": "electropop", "country_code": "jp", "country_name": "Japan", "summary": "Electropop is a type of electronic pop music which features crackly synthesizers prominently in the mix.   Electropop has become an increasingly common term for this music post-2000 whereas in earlier years, synthpop was probably the more common term for pop music using synthesizers.\n\nWhen Kraftwerk first appeared in the mid-1970's, their music was described as electronic body music (ebm) in Germany, Krautrock in England, and technopop in Japan.", "url": null, "artists": [{"artist": "AD\u00c9LA", "streams": null, "best_position": null}, {