eams": null, "best_position": null}, {"artist": "Ariana Grande", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Black Eyed Peas", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Chappell Roan", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Dua Lipa", "streams": null, "best_position": null}, {"artist": "Jimin", "streams": null, "best_position": null}, {"artist": "Justin Bieber", "streams": null, "best_position": null}]}, "disco": {"genre": "disco", "country_code": "py", "country_name": "Paraguay", "summary": "Disco is a genre of dance-oriented music that originated in African American, gay and Hispanic American communities in 1970s. In what is considered a forerunner to disco style clubs in February 1970 New York City DJ David Mancuso opened The Loft, a members-only private dance club set in his own home. Most agree that the first disco songs were released in 1973, though some claim that Soul Makossa by Manu Dibango's from 1972 to be the first disco record.", "url": null, "artists": [{"artist": "ABBA", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Dua Lipa", "streams": null, "best_position": null}, {"artist": "Katy Perry", "streams": null, "best_position": null}, {"artist": "Kendrick Lamar", "streams": null, "best_position": null}, {"artist": "Michael Jackson", "streams": null, "best_position": null}, {"artist": "Queen", "streams": null, "best_position": null}, {"artist": "Zara Larsson", "streams": null, "best_position": null}]}, "electronic": {"genre": "electronic", "country_code": "py", "country_name": "Paraguay", "summary": "Electronic music refers to music that emphasizes the use of electronic musical instruments or electronic music technology as a central aspect of the sound of the music. Historically, electronic music was considered to be any music created with the use of electronic musical instruments or electronic processing, but in modern times, that distinction has been lost because almost all recorded music today, and the majority of live music performances, depend on extensive use of electronics.", "url": null, "artists": [{"artist": "BTS", "streams": 26226, "best_position": 4}, {"artist": "Arctic Monkeys", "streams": null, "best_position": null}, {"artist": "Beyonc\u00e9", "streams": null, "best_position": null}, {"artist": "Billie Eilish", "streams": null, "best_position": null}, {"artist": "Britney Spears", "streams": null, "best_position": null}, {"artist": "Calvin Harris", "streams": null, "best_position": null}, {"artist": "Charli xcx", "streams": null, "best_position": null}, {"artist": "Daddy Yankee", "streams": null, "best_position": null}, {"artist": "Daft Punk", "streams": null, "best_position": null}, {"artist": "Dua Lipa", "streams": null, "best_position": null}, {"artist": "Gorillaz", "streams": null, "best_position": null}, {"artist": "Jimin", "streams": null, "best_position": null}]}, "electropop": {"genre": "electropop", "country_code": "py", "country_name": "Paraguay", "summary": "Electropop is a type of electronic pop music which features crackly synthesizers prominently in the mix.   Electropop has become an increasingly common term for this music post-2000 whereas in earlier years, synthpop was probably the more common term for pop music using synthesizers.\n\nWhen Kraftwerk first appeared in the mid-1970's, their music was described as electronic body music (ebm) in Germany, Krautrock in England, and technopop in Japan.", "url": null, "artists": [{"artist": "AD\u00c9LA", "streams": null, "best_position":