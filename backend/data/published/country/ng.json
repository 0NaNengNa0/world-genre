lastfm_listeners": 122, "deezer_fans": 62676}, {"artist": "Dave", "streams": 50660, "lastfm_listeners": 246, "deezer_fans": null}], "genre_details": {"afrobeat": {"genre": "afrobeat", "country_code": "ng", "country_name": "Nigeria", "summary": "Afrobeat is a fusion of Jazz, Funk and West African Highlife. Nigerian musician and bandleader Fela Kuti is credited with inventing the term and with pioneering and popularizing the style in Africa in the 70s. Afrobeat can be seen as a form of protest music since it addresses political issues, often seeking direct confrontation with the powers that be in the process. \n\nPlease do not tag afrobeats songs into the genre.", "url": null, "artists": [{"artist": "Asake", "streams": 1180533, "best_position": 3}, {"artist": "Rema", "streams": 497357, "best_position": 1}, {"artist": "Davido", "streams": 481483, "best_position": 2}, {"artist": "BNXN", "streams": 421971, "best_position": 13}, {"artist": "Wizkid", "streams": 138439, "best_position": 43}, {"artist": "Adekunle GOLD", "streams": null, "best_position": null}, {"artist": "Ckay", "streams": null, "best_position": null}, {"artist": "Joeboy", "streams": null, "best_position": null}, {"artist": "Tiwa Savage", "streams": null, "best_position": null}, {"artist": "Tyla", "streams": null, "best_position": null}]}, "afrobeats": {"genre": "afrobeats", "country_code": "ng", "country_name": "Nigeria", "summary": "Distinct from Afrobeat, is Afrobeats - a sound originating in Nigeria in the 21st century, which takes in diverse influences and is an eclectic combination of rap, reggae, dancehall, and even R&B.\n\nFrom early in the 21st century, a new type of sound, originating in Nigeria, has become increasingly prominent in African popular music. This name echoes Afrobeat, the 1970s fusion of Jazz and traditional Nigerian and Ghanaian music which is an important influence, but Afrobeats is a largely different style.", "url": null, "artists": [{"artist": "Asake", "streams": 1180533, "best_p